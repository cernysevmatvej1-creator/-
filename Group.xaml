<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Group.NewPage1"
             Title="Информация о группе"
             BackgroundColor="#0D0D0D">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12" VerticalOptions="Start">

            <!-- Карточка с информацией о группе -->
            <Frame BackgroundColor="#1C1C1E" 
                   CornerRadius="16" 
                   Padding="16" 
                   Margin="0,0,0,8"
                   HasShadow="True"
                   BorderColor="#2C2C2E">

                <VerticalStackLayout Spacing="14">

                    <Label Text="ИНФОРМАЦИЯ О ГРУППЕ" 
                           TextColor="#8E8E93" 
                           FontSize="11" 
                           FontAttributes="Bold"
                           CharacterSpacing="1.5"/>

                    <!-- Блок с ID группы -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="ID ГРУППЫ" 
                               TextColor="#8E8E93" 
                               FontSize="10" 
                               CharacterSpacing="1.2"/>

                        <!-- ID и кнопка КОПИРОВАТЬ в одном ряду -->
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Frame Grid.Column="0"
                                   BackgroundColor="#2C2C2E" 
                                   CornerRadius="10" 
                                   Padding="12,10" 
                                   BorderColor="#3A3A3C">
                                <Label Text="{Binding IdGroup, FallbackValue='12345'}" 
                                       TextColor="#0A84FF" 
                                       FontSize="15" 
                                       FontAttributes="Bold"
                                       FontFamily="Menlo"
                                       VerticalTextAlignment="Center"/>
                            </Frame>

                            <Button Grid.Column="1"
                                    Text="📋 Копировать"
                                    Command="{Binding CopyIdCommand}"
                                    CommandParameter="{Binding IdGroup}"
                                    Background="#0A84FF" 
                                    TextColor="White"
                                    FontSize="13"
                                    FontAttributes="Bold"
                                    CornerRadius="10"
                                    HeightRequest="44"
                                    Padding="12,0"/>
                        </Grid>

                        <Label Text="✓ ID скопирован!" 
                               TextColor="#30D158" 
                               FontSize="10"
                               HorizontalTextAlignment="Center"
                               IsVisible="{Binding IsIdCopied}"/>
                    </VerticalStackLayout>

                    <!-- Разделитель -->
                    <BoxView HeightRequest="1" BackgroundColor="#2C2C2E" Margin="0,2"/>

                    <!-- Блок с названием группы -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="НАЗВАНИЕ ГРУППЫ" 
                               TextColor="#8E8E93" 
                               FontSize="10" 
                               CharacterSpacing="1.2"/>

                        <HorizontalStackLayout Spacing="10">
                            <Frame CornerRadius="22" 
                                   HeightRequest="44" 
                                   WidthRequest="44" 
                                   Padding="0" 
                                   BackgroundColor="#BF5AF2" 
                                   BorderColor="Transparent">
                                <Label Text="{Binding NameGroup, StringFormat='{}{0:0:1}', FallbackValue='G'}" 
                                       TextColor="White" 
                                       FontSize="20" 
                                       FontAttributes="Bold"
                                       HorizontalOptions="Center" 
                                       VerticalOptions="Center"/>
                            </Frame>

                            <Label Text="{Binding NameGroup, FallbackValue='Название группы'}" 
                                   TextColor="White" 
                                   FontSize="18" 
                                   FontAttributes="Bold"
                                   VerticalOptions="Center"
                                   LineBreakMode="TailTruncation"/>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </Frame>

            <!-- Карточка с действиями -->
            <Frame BackgroundColor="#1C1C1E" 
                   CornerRadius="16" 
                   Padding="14" 
                   HasShadow="True"
                   BorderColor="#2C2C2E">

                <VerticalStackLayout Spacing="10">

                    <Label Text="ДЕЙСТВИЯ" 
                           TextColor="#8E8E93" 
                           FontSize="11" 
                           FontAttributes="Bold"
                           CharacterSpacing="1.5"/>

                    <HorizontalStackLayout Spacing="8" HorizontalOptions="FillAndExpand">
                        <Button Text="📋 Заявки" 
                                Command="{Binding PeretiBidCommand}" 
                                Background="#0A84FF" 
                                TextColor="White"
                                FontSize="13"
                                FontAttributes="Bold"
                                CornerRadius="10"
                                HeightRequest="44"
                                HorizontalOptions="FillAndExpand"
                                Padding="0"/>
                        <Button Text="💬 Чат" 
                                Command="{Binding PereitiChatCommand}" 
                                Background="#30D158" 
                                TextColor="White"
                                FontSize="13"
                                FontAttributes="Bold"
                                CornerRadius="10"
                                HeightRequest="44"
                                HorizontalOptions="FillAndExpand"
                                Padding="0"/>
                    </HorizontalStackLayout>

                    <HorizontalStackLayout Spacing="8" HorizontalOptions="FillAndExpand">
                        <Button Text="📅 Создать встречу" 
                                Command="{Binding PeretiVstreCommand}" 
                                Background="#5E5CE6" 
                                TextColor="White"
                                FontSize="13"
                                FontAttributes="Bold"
                                CornerRadius="10"
                                HeightRequest="44"
                                HorizontalOptions="FillAndExpand"
                                Padding="0"/>
                        <Button Text="📋 Встречи" 
                                Command="{Binding PeretiLoadedVstreCommand}" 
                                Background="#FF9F0A" 
                                TextColor="White"
                                FontSize="13"
                                FontAttributes="Bold"
                                CornerRadius="10"
                                HeightRequest="44"
                                HorizontalOptions="FillAndExpand"
                                Padding="0"/>
                    </HorizontalStackLayout>

                    <Button Text="👥 Участники" 
                            Command="{Binding PeretiLoadedMembersCommand}" 
                            Background="#BF5AF2" 
                            TextColor="White"
                            FontSize="13"
                            FontAttributes="Bold"
                            CornerRadius="10"
                            HeightRequest="44"
                            HorizontalOptions="FillAndExpand"
                            Padding="0"/>

                </VerticalStackLayout>

            </Frame>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>